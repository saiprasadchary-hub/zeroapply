+    const reqPath = requested.pathname.replace(/\/$/, '').toLowerCase();
+
+    // Check pathname: allow exact match, or if on LinkedIn jobs platform allow /jobs/ search, collections, view
+    const isLinkedIn = (current.hostname === 'linkedin.com' || current.hostname.endsWith('.linkedin.com'))
+      && (requested.hostname === 'linkedin.com' || requested.hostname.endsWith('.linkedin.com'));
