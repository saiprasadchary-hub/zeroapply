+
+    // Required query parameters (keywords / search query)
+    const primaryQueryKeys = ['keywords', 'q', 'search', 'sc.keyword'];
+    for (const key of primaryQueryKeys) {
+      if (requested.searchParams.has(key)) {
+        const reqVal = (requested.searchParams.get(key) || '').toLowerCase().trim();
+        const curVal = (current.searchParams.get(key) || '').toLowerCase().trim();
+        if (reqVal && curVal !== reqVal && !curPath.startsWith('/jobs/view')) {
+          return false;
+        }
+      }
+    }
+
+    // For other parameters:
+    for (const [key, value] of requested.searchParams) {
+      if (primaryQueryKeys.includes(key)) continue;
+      // LinkedIn frequently replaces location with geoId; don't fail if location was converted
+      if (key === 'location') {
+        if (current.searchParams.has('location')) {
+          const curLoc = (current.searchParams.get('location') || '').toLowerCase().replace(/\+/g, ' ').trim();
+          const reqLoc = value.toLowerCase().replace(/\+/g, ' ').trim();
+          if (curLoc && reqLoc && !curLoc.includes(reqLoc) && !reqLoc.includes(curLoc) && !current.searchParams.has('geoId')) {
+            return false;
+          }
+        }
+        continue;
+      }
+      // If current URL contains the key, verify value matches
+      if (current.searchParams.has(key)) {
+        const curVals = current.searchParams.getAll(key);
+        if (!curVals.includes(value)) return false;
+      }
+    }
+    return true;
   } catch {
     return false;
   }
