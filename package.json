{
  "name": "zeeroaaply",
  "private": true,
  "version": "1.0.0",
  "description": "ZeroApply High-Output Persona Management Desktop App",
  "author": "ZeroApply Team",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && set ELECTRON_RENDERER_URL=http://localhost:5173&& electron .\"",
    "dist:exe": "npm run build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.zeroapply.app",
    "productName": "ZeroApply Desktop",
    "npmRebuild": false,
    "directories": {
      "output": "dist_desktop"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload-popup.cjs",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.7",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^8.0.2"
  }
}
